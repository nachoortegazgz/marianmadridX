{
  "name": "@wix/headless-forms",
  "version": "0.0.45",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "test": "vitest",
    "lint:fix": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "test:cjs-esm": "cjs-esm-build-verifier --subpath react services"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "yarn lint:fix"
  },
  "files": [
    "dist",
    "cjs",
    "react",
    "services"
  ],
  "exports": {
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./cjs/dist/react/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.js",
      "require": "./cjs/dist/services/index.js"
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.9.0",
    "@vitest/ui": "^3.1.4",
    "@wix/cjs-esm-build-verifier": "1.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "@wix/form-public": "^0.145.0",
    "@wix/forms": "^1.0.399",
    "@wix/headless-utils": "0.0.12",
    "@wix/services-definitions": "^1.0.1",
    "@wix/services-manager-react": "^1.0.3",
    "react-aria-components": "^1.13.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "wix": {
    "artifact": {
      "artifactId": "headless-forms",
      "groupId": "com.wixpress.headless-components"
    }
  },
  "falconPackageHash": "c7ca0742ab1beaa2492b07e6f464dd0e5c0ca940bb56716fe1e2da74"
}