{
  "name": "@wix/headless-media",
  "version": "0.0.25",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "test": "vitest",
    "lint:fix": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "test:cjs-esm": "cjs-esm-build-verifier --subpath react core services"
  },
  "files": [
    "dist",
    "cjs",
    "react",
    "services",
    "server-actions",
    "astro"
  ],
  "exports": {
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./cjs/dist/react/index.js"
    },
    "./core": {
      "types": "./dist/react/core/index.d.ts",
      "import": "./dist/react/core/index.js",
      "require": "./cjs/dist/react/core/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.js",
      "require": "./cjs/dist/services/index.js"
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.9.0",
    "@vitest/ui": "^3.1.4",
    "@wix/cjs-esm-build-verifier": "1.0.0",
    "@wix/headless-utils": "0.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "@wix/sdk": "^1.17.1",
    "@wix/services-definitions": "^1.0.1",
    "@wix/services-manager-react": "^1.0.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "wix": {
    "artifact": {
      "artifactId": "headless-media",
      "groupId": "com.wixpress.headless-components"
    }
  },
