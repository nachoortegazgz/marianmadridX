{
  "name": "@wix/headless-utils",
  "version": "0.0.12",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "test": "vitest",
    "lint:fix": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "test:cjs-esm": "cjs-esm-build-verifier --subpath react"
  },
  "files": [
    "dist",
    "cjs",
    "react"
  ],
  "exports": {
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./cjs/dist/react/index.js"
    }
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@wix/cjs-esm-build-verifier": "1.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3"
  },
  "peerDependencies": {
    "react": ">=16.3.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "wix": {
    "artifact": {
      "artifactId": "headless-utils",
      "groupId": "com.wixpress.headless-components"
    }
  },
  "falconPackageHash": "cbbf98e2574c0a7bd148db4c0ada5551d7112a3abd05a892363abc28"
}