---
to: <%- config.kebabCaseName -%>.module.css
---
.<%- config.camelCaseName -%> {
  background-color: #ffffff;
  border: 1px solid #e0e0e0;
  border-radius: 12px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  padding: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.image {
  display: block;
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
}

.imagePlaceholder {
  width: 100%;
  aspect-ratio: 16 / 9;
  background-color: #f0f0f0;
}

.body {
  padding: 1.25rem 1.5rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.title {
  margin: 0;
  color: #1a1a1a;
  font: bold 20px/1.3 sans-serif;
  text-align: start;
}

.description {
  margin: 0;
  color: #666666;
  font: normal 14px/1.5 sans-serif;
  text-align: start;
}

.fallbackDirection:not([dir]) {
  direction: var(--wix-opt-in-direction);
}
