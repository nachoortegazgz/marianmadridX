---
to: <%- route -%>.extension.ts
---
import { extensions } from '<%- builderPackage -%>';

export default extensions.contextProvider({
  id: '<%- config.id -%>',
  name: '<%- config.name -%>',
  type: '<%- config.type -%>',
  displayName: '<%- config.name -%>',
  context: {
    items: {
      count: {
        dataType: 'number',
        displayName: 'Counter current value',
      },
      decrement: {
        dataType: 'function',
        displayName: 'Decrement counter value by 1',
        function: {},
      },
      increment: {
        dataType: 'function',
        displayName: 'Increment counter value by 1',
        function: {},
      },
      setCount: {
        dataType: 'function',
        displayName: 'Set counter value to a specific number',
        function: {
          parameters: [
            {
              dataType: 'number',
              displayName: 'New counter value',
            },
          ],
        },
      },
    },
  },
  data: {
    initialCount: {
      dataType: 'number',
      defaultValue: 0,
      deprecated: false,
      displayName: 'Initial Count',
    },
  },
  resources: {
    client: {
      url: '<%- config.provider -%>',
    },
    contextSpecifier: {
      hook: 'useCounterContext',
    },
  },
});
