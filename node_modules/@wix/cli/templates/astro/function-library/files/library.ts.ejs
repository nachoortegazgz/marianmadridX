/**
This file contains the utility functions exposed by this function library.

Every exported function must be described in the `functions` map in
`<%- route -%>.extension.ts`, so that it can be used in the Wix editor.
*/

export function formatPrice(amount: number, currencySymbol = '$'): string {
  return `${currencySymbol}${amount.toFixed(2)}`;
}
