---
to: <%- route -%>.extension.ts
---
import { extensions } from '<%- builderPackage -%>';

export default extensions.functionLibrary({
  id: '<%- config.id -%>',
  name: '<%- config.name -%>',
  type: '<%- config.type -%>',
  functions: {
    formatPrice: {
      displayName: 'Format price',
      description: 'Formats an amount as a price string',
      parameters: [
        {
          dataType: 'number',
          displayName: 'Amount',
        },
        {
          dataType: 'text',
          displayName: 'Currency symbol',
          optional: true,
        },
      ],
      returns: {
        dataType: 'text',
        displayName: 'Formatted price',
      },
    },
  },
  resources: {
    client: {
      url: '<%- config.library -%>',
    },
  },
});
